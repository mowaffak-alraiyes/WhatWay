# BridgeCare — copy to .env. Never commit real keys.
#   cp .env.example .env

# --- LLM: local Ollama only (free) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# --- Neon (auth + comments) ---
NEON_DB_HOST=
NEON_DB_NAME=
NEON_DB_USER=
NEON_PASSWORDLESS_TOKEN=
NEON_SSLMODE=require

# --- WhatsApp: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=bridgecare-verify
WHATSAPP_DEFAULT_LANG=en

GOOGLE_FORM_COMMUNITY_REPORT=https://docs.google.com/forms/d/e/1FAIpQLScZUiy0MirYBsbjPC50_AyZ2I6BdnjmnYKCQOcUUGximAmNVw/viewform
GOOGLE_FORM_CLINIC_UPDATE=https://docs.google.com/forms/d/e/1FAIpQLSdHExiaL4A0-gbHOF2swbdlLQQIUPf0WINCaZrJsQDrliuUwA/viewform
GOOGLE_FORMS_CSV_URL=

# --- Clinic ops agent (Telegram approval → GitHub) ---
CITY_SCOPE=chicago
# CITY_SCOPE=national
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
RESOURCES_GITHUB_REPO=mowaffak-alraiyes/refugee-resources
# GITHUB_TOKEN=   # optional if git/gh isn't already logged in

# --- Voice (optional; Pip speak works free via browser without these) ---
# Mic / Whisper transcription needs OpenAI (same pattern as David's Vera):
# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=nova
# ELEVENLABS_API_KEY=   # optional nicer TTS
